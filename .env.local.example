# =============================================================================
# HEALTHY FOOD POS & STOCK MANAGEMENT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and populate with your project's credentials.
# Do NOT commit .env or .env.local to Git version control.

# -----------------------------------------------------------------------------
# 1. Firebase Web App Configuration (Store Owner Firebase Console)
# -----------------------------------------------------------------------------
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app (SDK setup and configuration -> Config)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-store-pos-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-store-pos-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-store-pos-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# 2. Cloudinary Media Upload (Store Owner Cloudinary Account)
# -----------------------------------------------------------------------------
# Found in: Cloudinary Dashboard -> Product Environment Settings -> Upload Presets
# Upload Preset must be created with Signing Mode set to "Unsigned"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=products
